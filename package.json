{
  "name": "browseros",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#bos-plugin-sdk": "./src/lib/bos-plugins/sdk/index.ts"
  },
  "scripts": {
    "gen:apps": "node tools/gen-apps.mjs",
    "gen:vad": "node tools/copy-vad-assets.mjs",
    "predev": "node tools/gen-apps.mjs && node tools/copy-vad-assets.mjs",
    "dev": "next dev",
    "prebuild": "node tools/gen-apps.mjs && node tools/copy-vad-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "NODE_OPTIONS='--conditions=react-server --require ./tests/_no-external-network.cjs --require ./tests/_no-live-deployment.cjs' playwright test -c playwright.unit.config.ts",
    "test:bench": "NODE_OPTIONS='--conditions=react-server --require ./tests/_no-external-network.cjs --require ./tests/_no-live-deployment.cjs' playwright test -c playwright.bench.config.ts",
    "test:supervisor": "node --test \"tests/supervisor/*.test.mjs\"",
    "coverage:clean": "rm -rf coverage",
    "test:coverage": "npm run coverage:clean && c8 --no-clean --reporter=none npm run test:unit && c8 --no-clean --reporter=none npm run test:supervisor && c8 report",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "supervisor": "node tools/supervisor/supervisor.mjs",
    "validate:methods": "node scripts/validate-method-layer.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.75",
    "@anthropic-ai/sdk": "^0.57.0",
    "@copilotkit/react-core": "^1.61.2",
    "@copilotkit/react-ui": "^1.61.2",
    "@copilotkit/runtime": "^1.61.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/react-virtual": "^3.14.9",
    "ai": "^6.0.211",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "flexsearch": "^0.7.43",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "next": "16.2.9",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "telegram": "^2.26.16",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.76",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "3.25.76"
  }
}
