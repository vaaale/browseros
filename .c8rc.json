{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "bastion/src/**/*.ts",
    "tools/supervisor/**/*.mjs"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.d.ts",
    "src/apps/_*.generated.ts"
  ],
  "extension": [".ts", ".tsx", ".mjs"],
  "all": true,
  "reporter": ["text-summary", "html", "json-summary", "lcovonly"],
  "reports-dir": "coverage"
}
